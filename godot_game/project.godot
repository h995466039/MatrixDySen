[application]
config/name="星环回声 · Godot 垂直切片"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027, 0.067, 0.11, 1)

[input]
pause_game={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32)]}
cancel_build={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194305)]}
rotate_building={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":82)]}
